# ==============================================================================
# PromptHash Stellar Environment Configuration
# ==============================================================================
# This file defines the environment configuration for PromptHash Stellar.
# Copy this template to `.env` or `.env.local` for local development.
# In production, inject these variables via your secrets manager / cloud platform.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SHARED RUNTIME & SYSTEM
# ------------------------------------------------------------------------------
# STELLAR_SCAFFOLD_ENV
# Description: Defines the current runtime environment profile.
# Acceptable Values: "development", "staging", "production", "test"
# Default: "development"
STELLAR_SCAFFOLD_ENV=development

# XDG_CONFIG_HOME
# Description: Directory path for configuration caches and local wallet scaffold files.
# Acceptable Values: Valid relative or absolute directory path (e.g., ".config")
# Default: ".config"
XDG_CONFIG_HOME=.config

# ------------------------------------------------------------------------------
# 2. STELLAR NETWORK & SMART CONTRACT CONFIGURATION (FRONTEND & API)
# ------------------------------------------------------------------------------
# PUBLIC_STELLAR_NETWORK
# Description: Stellar network identity for transaction submission and wallet signing.
# Acceptable Values: "TESTNET", "PUBLIC", "FUTURENET", "LOCAL"
# Default: "TESTNET"
PUBLIC_STELLAR_NETWORK=TESTNET

# PUBLIC_STELLAR_NETWORK_PASSPHRASE
# Description: Network passphrase used to sign and verify Stellar transaction envelopes.
# Acceptable Values:
#   - Testnet: "Test SDF Network ; September 2015"
#   - Public:  "Public Global Stellar Network ; September 2015"
#   - Futurenet: "Test SDF Future Network ; October 2022"
# Default: "Test SDF Network ; September 2015"
PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# PUBLIC_STELLAR_RPC_URL
# Description: Endpoint URL for the Soroban RPC provider.
# Acceptable Values: Valid HTTPS URL pointing to a Soroban RPC node
# Default: "https://soroban-testnet.stellar.org"
PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# PUBLIC_STELLAR_HORIZON_URL
# Description: Endpoint URL for the Stellar Horizon REST API.
# Acceptable Values: Valid HTTPS URL pointing to Horizon
# Default: "https://horizon-testnet.stellar.org"
PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# PUBLIC_PROMPT_HASH_CONTRACT_ID
# Description: StrKey Contract ID (starting with 'C') of the deployed PromptHash marketplace smart contract.
# Acceptable Values: Valid 56-character Stellar StrKey contract identifier (e.g., "CA3D5KRYM...")
# Default: "CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" (placeholder for local dev)
PUBLIC_PROMPT_HASH_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# PUBLIC_STELLAR_NATIVE_ASSET_CONTRACT_ID
# Description: Contract ID of the built-in native XLM SAC token on Soroban.
# Acceptable Values: 56-character Stellar StrKey contract identifier
# Default (Testnet XLM): "CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC"
PUBLIC_STELLAR_NATIVE_ASSET_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# PUBLIC_STELLAR_SIMULATION_ACCOUNT
# Description: Stellar account public key (G...) used for fee simulation and dry-run contract invocations.
# Acceptable Values: Valid 56-character Stellar public address starting with 'G'
# Default: "GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
PUBLIC_STELLAR_SIMULATION_ACCOUNT=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# PUBLIC_UNLOCK_PUBLIC_KEY
# Description: Public key corresponding to the marketplace unlock service, used by the frontend to verify encryption.
# Acceptable Values: Base64-encoded Curve25519 / Libsodium public key (minimum 20 characters)
# Default: "ZHVtbXktcHVibGljLWtleS12YWx1ZS1oZXJl"
PUBLIC_UNLOCK_PUBLIC_KEY=ZHVtbXktcHVibGljLWtleS12YWx1ZS1oZXJl

# PUBLIC_CHAT_API_BASE
# Description: Optional external AI chat playground gateway endpoint for testing prompt output.
# Acceptable Values: Valid HTTPS URL
# Default: "https://secret-ai-gateway.onrender.com"
PUBLIC_CHAT_API_BASE=https://secret-ai-gateway.onrender.com

# ------------------------------------------------------------------------------
# 3. SERVERLESS UNLOCK RUNTIME & CRYPTOGRAPHY (BACKEND SECRETS)
# ------------------------------------------------------------------------------
# CHALLENGE_TOKEN_SECRET
# Description: Secret HMAC key used to sign and verify wallet challenge auth tokens during prompt unlock.
# Acceptable Values: High-entropy string (minimum 16 characters in production)
# Default: "super-secret-challenge-token-string"
CHALLENGE_TOKEN_SECRET=super-secret-challenge-token-string

# UNLOCK_PUBLIC_KEY
# Description: Base64-encoded public key for decrypting and unwrapping seller prompt keys.
# Acceptable Values: Base64-encoded string
# Default: "ZHVtbXktcHVibGljLWtleS12YWx1ZS1oZXJl"
UNLOCK_PUBLIC_KEY=ZHVtbXktcHVibGljLWtleS12YWx1ZS1oZXJl

# UNLOCK_PRIVATE_KEY
# Description: Base64-encoded private key held only by the serverless backend to unwrap purchased prompts.
# Acceptable Values: Base64-encoded string (NEVER expose to frontend or commit to version control)
# Default: "ZHVtbXktcHJpdmF0ZS1rZXktdmFsdWUtaGVyZQ=="
UNLOCK_PRIVATE_KEY=ZHVtbXktcHJpdmF0ZS1rZXktdmFsdWUtaGVyZQ==

# ------------------------------------------------------------------------------
# 4. SECRETS ROTATION & ZERO-DOWNTIME GRACE PERIODS (OPTIONAL)
# ------------------------------------------------------------------------------
# ADMIN_ROTATION_TOKEN
# Description: Bearer authorization token required to trigger administrative key rotation endpoints.
# Acceptable Values: High-entropy secret string
# ADMIN_ROTATION_TOKEN=

# CHALLENGE_TOKEN_SECRET_PREVIOUS
# Description: Previous challenge secret retained during key rotation to allow in-flight tokens to complete.
# Acceptable Values: High-entropy secret string
# CHALLENGE_TOKEN_SECRET_PREVIOUS=

# CHALLENGE_TOKEN_ROTATION_TIMESTAMP
# Description: Epoch timestamp in milliseconds when secret rotation occurred.
# Acceptable Values: Integer epoch milliseconds (e.g., 1740000000000)
# CHALLENGE_TOKEN_ROTATION_TIMESTAMP=

# CHALLENGE_TOKEN_GRACE_PERIOD_MS
# Description: Duration in milliseconds for which the previous secret remains valid after rotation.
# Acceptable Values: Positive integer in milliseconds (e.g., 300000 for 5 minutes)
# Default: 300000
# CHALLENGE_TOKEN_GRACE_PERIOD_MS=300000

# ------------------------------------------------------------------------------
# 5. RATE LIMITING, AUDIT & INFRASTRUCTURE (OPTIONAL)
# ------------------------------------------------------------------------------
# REDIS_URL
# Description: Connection URI for Redis instance used for distributed rate limiting and replay prevention.
# Acceptable Values: redis://[user:password@]host[:port][/db] or rediss:// for TLS
# Default: Unset (falls back to resilient in-memory LRU cache)
# REDIS_URL=redis://127.0.0.1:6379

# MONGODB_URI
# Description: MongoDB connection URI for persistent audit trails, reviews, and moderation records.
# Acceptable Values: mongodb:// or mongodb+srv:// connection URI
# Default: "mongodb://127.0.0.1:27017/prompthash"
# MONGODB_URI=mongodb://127.0.0.1:27017/prompthash

# Optional — Datadog / PagerDuty monitoring (#235)
# DATADOG_API_KEY=
# DATADOG_APP_KEY=
# PAGERDUTY_ROUTING_KEY=

# Comma-separated wallet allowlist for off-chain review moderation. Leave unset to disable moderation.
# MODERATOR_ADDRESSES=GMODERATORADDRESS...

# Indexer start ledger for backfill (0 = start from the latest ledger)
# INDEXER_START_LEDGER=0

# Off-chain encrypted blob storage (issue #499)
# VITE_BLOB_STORAGE_ENDPOINT=http://localhost:5000
# VITE_IPFS_GATEWAY=https://ipfs.io/ipfs/

# PORT
# Description: HTTP server listener port for standalone backend server.
# Acceptable Values: Integer port number (e.g., 3000, 8080)
# Default: 3000
# PORT=3000
